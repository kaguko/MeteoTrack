# Copy this file to `.env` (git-ignored) to enable the optional Gemini suggestions.
#
# GEMINI_API_KEY is compiled into BuildConfig, so anyone who unpacks the APK can read it.
# For a public release, keep it empty (the app falls back to built-in offline tips) or
# proxy the request through your own backend instead of shipping a key.
GEMINI_API_KEY=MY_GEMINI_API_KEY
